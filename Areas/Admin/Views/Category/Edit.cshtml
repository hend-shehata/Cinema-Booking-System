@model Cinema_Booking_System.Models.Category
@{
    ViewData["Title"] = "Edit Category";
}

<div class="card">
    <div class="card-header"><h5 class="mb-0">Edit Category</h5></div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Category" asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </form>
    </div>
</div>