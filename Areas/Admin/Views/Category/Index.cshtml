@model List<Cinema_Booking_System.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Categories</h5>
        <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-primary btn-sm">
            <span class="fas fa-plus"></span> Add Category
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-200">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Movies</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td>@c.Name</td>
                            <td><span class="badge bg-primary">@c.Movies.Count</span></td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Category" asp-action="Edit" asp-route-id="@c.Id"
                                   class="btn btn-warning btn-sm">Edit</a>
                                <form asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@c.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>