@model Cinema_Booking_System.Models.Cinema
@{
    ViewData["Title"] = "Add Cinema";
}

<div class="card">
    <div class="card-header"><h5 class="mb-0">Add Cinema</h5></div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Cinema" asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Image</label>
                <input type="file" name="img" class="form-control" accept="image/*" />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-area="Admin" asp-controller="Cinema" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </form>
    </div>
</div>