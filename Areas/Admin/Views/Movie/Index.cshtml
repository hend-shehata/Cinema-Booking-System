@model List<Cinema_Booking_System.Models.Movie>
@{
    ViewData["Title"] = "Movies";
}

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Movies</h5>
        <a asp-area="Admin" asp-controller="Movie" asp-action="Create" class="btn btn-primary btn-sm">Add Movie</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="bg-200">
                <tr><th>Image</th><th>Name</th><th>Category</th><th>Cinema</th><th>Price</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td><img src="~/images/movies/@m.MainImg" width="50" class="rounded" /></td>
                        <td>@m.Name</td>
                        <td>@m.Category.Name</td>
                        <td>@m.Cinema.Name</td>
                        <td>@m.Price.ToString("0.##")</td>
                        <td>@(m.Status ? "Available" : "Unavailable")</td>
                        <td class="text-end">
                            <a asp-area="Admin" asp-controller="Movie" asp-action="Edit" asp-route-id="@m.Id" class="btn btn-warning btn-sm">Edit</a>
                            <form asp-area="Admin" asp-controller="Movie" asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this movie?');">
                                <button class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>