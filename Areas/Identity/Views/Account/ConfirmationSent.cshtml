@{
    ViewData["Title"] = "Check Your Email";
    Layout = "_Layout";
}

<div class="account-page">
    <div class="account-card text-center">
        <div class="account-brand">CINÉMA.</div>
        <h2>Email Sent!</h2>
        <p class="account-desc">
            If the account exists and needs confirmation,
            a confirmation email has been sent.
            Please check your inbox.
        </p>
        <a asp-action="Login" class="account-back">Back to Login</a>
    </div>
</div>