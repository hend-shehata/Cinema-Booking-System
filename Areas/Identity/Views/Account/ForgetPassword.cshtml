@model Cinema_Booking_System.ViewModels.ForgetPasswordVM

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<style>
    .account-page {
        min-height: 80vh;
        display: grid;
        place-items: center;
        padding: 40px 20px;
        background: radial-gradient(circle at top, #302719, #11151e 60%, #090b10);
        color: white;
    }

    .account-card {
        width: 100%;
        max-width: 470px;
        padding: 42px;
        border: 1px solid #303744;
        border-radius: 20px;
        background: #151a24;
        box-shadow: 0 20px 60px #0008;
    }

    .account-brand {
        text-align: center;
        color: #d8ae62;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: 3px;
        margin-bottom: 25px;
    }

    .account-card h2 {
        text-align: center;
        font-weight: 800;
    }

    .account-desc {
        text-align: center;
        color: #9298a5;
        font-size: 14px;
        line-height: 1.7;
        margin: 12px 0 28px;
    }

    .account-card label {
        color: #d8dbe2;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .account-input {
        background: #1e2531 !important;
        border: 1px solid #343d4b !important;
        color: white !important;
        padding: 13px !important;
    }

        .account-input:focus {
            border-color: #d8ae62 !important;
            box-shadow: 0 0 0 3px #d8ae6220 !important;
        }

        .account-input::placeholder {
            color: #7e8795;
        }

    .account-btn {
        width: 100%;
        padding: 13px;
        margin-top: 15px;
        border: 0;
        border-radius: 9px;
        background: linear-gradient(135deg, #e4c17e, #b98b43);
        color: #17130c;
        font-weight: 800;
    }

    .account-validation {
        color: #ff7777;
        font-size: 12px;
    }

    .account-back {
        display: block;
        text-align: center;
        margin-top: 22px;
        color: #d8ae62;
        text-decoration: none;
    }
</style>

<div class="account-page">
    <div class="account-card">
        <div class="account-brand">CINÉMA.</div>

        <h2>Forgot Password?</h2>
        <p class="account-desc">
            Enter your registered email address.
            We'll send you a verification code to reset your password.
        </p>

        <form asp-action="ForgetPassword" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="account-validation mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email"
                       class="form-control account-input"
                       placeholder="name@example.com" />
                <span asp-validation-for="Email"
                      class="account-validation"></span>
            </div>

            <button class="account-btn" type="submit">
                SEND VERIFICATION CODE
            </button>
        </form>

        <a asp-action="Login" class="account-back">
            Back to Sign In
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
