@model Cinema_Booking_System.ViewModels.ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div class="account-page">
    <div class="account-card">
        <div class="account-brand">CINÉMA.</div>

        <h2>Create New Password</h2>
        <p class="account-desc">
            Choose a strong password for your account.
        </p>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="account-validation mb-3"></div>

            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div class="mb-3">
                <label asp-for="NewPassword">New Password</label>
                <input asp-for="NewPassword"
                       class="form-control account-input"
                       placeholder="Enter new password" />
                <span asp-validation-for="NewPassword"
                      class="account-validation"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword"
                       class="form-control account-input"
                       placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmPassword"
                      class="account-validation"></span>
            </div>

            <button type="submit" class="account-btn">
                RESET PASSWORD
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
